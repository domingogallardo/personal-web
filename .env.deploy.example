# Copy this file to .env.deploy and replace placeholder values.

# SSH access to your DigitalOcean host
export REMOTE_USER=root
export REMOTE_HOST=YOUR_SERVER_IP

# Optional remote deploy settings (defaults shown)
export REMOTE_PATH=/opt/web-domingo
export HOST_PORT=8080
export IMAGE_NAME=web-domingo
export CONTAINER_NAME=web-domingo

# Optional: if set together, updates /opt/web-domingo/nginx/.htpasswd
# for authenticated write access on /data.
# export HTPASSWD_USER=editor
# export HTPASSWD_PSS=change_me

# Optional: overlay /read during deploy from any local folder.
# export READ_SOURCE_DIR=/absolute/path/to/read
